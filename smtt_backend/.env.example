# .env.example - Configurações de Ambiente para o SMTT Backend
# Copie este arquivo como '.env' e altere os valores para o seu ambiente local ou produção.

# Ambiente do Flask (development | production)
FLASK_ENV=development
FLASK_APP=run.py

# Chaves de Criptografia (Gere chaves aleatórias seguras para produção usando python: secrets.token_hex(32))
SECRET_KEY=gere-uma-chave-aleatoria-forte-aqui
JWT_SECRET_KEY=gere-uma-chave-aleatoria-forte-aqui

# Banco de Dados de Produção (PostgreSQL no Supabase) - Usado quando FLASK_ENV=production
# Ex de Produção: postgresql://postgres.xxxx:senha@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://usuario:senha@localhost:5432/smtt

# Banco de Dados Local (Desenvolvimento) - Usado quando FLASK_ENV=development
# Deixe como sqlite:///smtt_local.db para usar SQLite local automaticamente, ou configure seu PostgreSQL local:
# Ex: postgresql://usuario:senha@localhost:5432/smtt_local
DATABASE_URL_LOCAL=sqlite:///smtt_local.db

# Conexão direta com a API do Supabase (para recursos adicionais se houver)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua-chave-anon-public-supabase

# Tokens de Integrações Externas
APIPLACAS_TOKEN=seu-token-da-api-placas-aqui

# Origens permitidas de CORS (separe por vírgula em produção)
# Produção oficial (inclua com e sem www)
CORS_ALLOWED_ORIGINS=https://smttpropria.com.br,https://www.smttpropria.com.br

# Limite por arquivo (10 MiB) e por requisição (70 MiB).
UPLOAD_MAX_FILE_SIZE=10485760
MAX_CONTENT_LENGTH=73400320
# Armazenamento de uploads (local | s3). Em producao, prefira s3.
STORAGE_BACKEND=local
S3_BUCKET=nome-do-bucket
S3_REGION=sa-east-1
S3_PREFIX=uploads
# Opcional para S3 compativel (MinIO, LocalStack etc.). Deixe vazio na AWS.
S3_ENDPOINT_URL=
# Tempo de validade do link privado de download, em segundos.
S3_PRESIGNED_URL_EXPIRES=900
# As credenciais usam a cadeia padrao da AWS: role da instancia/container,
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ou perfil local.

# Configurações do Administrador Inicial (semeado via criar_admin.py)
INITIAL_ADMIN_MATRICULA=defina-a-matricula-inicial
INITIAL_ADMIN_PASSWORD=gere-uma-senha-forte-e-exclusiva
INITIAL_ADMIN_NOME=Inspetor Chefe
INITIAL_ADMIN_CARGO=Agente de Trânsito
